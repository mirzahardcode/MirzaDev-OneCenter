# OneCenter R8 Keep Rules

# Preserve JNI native method signatures and native classes
-keepclasseswithmembernames class * {
    native <methods>;
}

-keep class com.mirzadev.onecenter.NativeAuth { *; }
-keep class com.mirzadev.onecenter.NativeCore { *; }
-keep class com.mirzadev.onecenter.NativeLogger { *; }
-keep class com.mirzadev.onecenter.NativeSecurity { *; }

# Preserve Gson data models
-keepclassmembers class com.mirzadev.onecenter.data.LatestInformation { *; }
-keepclassmembers class com.mirzadev.onecenter.data.GitHubApk { *; }
-keepclassmembers class com.mirzadev.onecenter.data.PrivateDocument { *; }
-keepclassmembers class com.mirzadev.onecenter.data.PrivateDocumentsResponse { *; }
